{
  "name": "hoop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --import ./scripts/server-runtime.mjs --test \"src/**/!(*.db).test.ts\"",
    "test:db": "tsx --import ./scripts/server-runtime.mjs --test --test-concurrency=1 \"src/**/*.db.test.ts\"",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "node --import ./scripts/server-runtime.mjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --import ./scripts/server-runtime.mjs ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "tsx --import ./scripts/server-runtime.mjs scripts/db-seed.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^6.0.2",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.64.0",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
